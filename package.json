{
  "name": "littlegods-games",
  "private": true,
  "version": "1.0.0",
  "description": "Launcher de juegos personales con descargas directas por WebTorrent",
  "author": "Littlegods Games",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev:renderer": "vite",
    "dev": "concurrently -k \"npm:dev:renderer\" \"wait-on http://localhost:5173 && cross-env VITE_DEV_SERVER_URL=http://localhost:5173 electron .\"",
    "build:renderer": "tsc -b && vite build",
    "build": "npm run build:renderer",
    "dist": "npm run dist:all",
    "dist:win": "npm run build:renderer && electron-builder --win nsis --publish never --config.directories.output=dist/windows",
    "dist:linux": "npm run build:renderer && electron-builder --linux AppImage --publish never --config.directories.output=dist/linux",
    "dist:all": "npm run dist:win && npm run dist:linux",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "^1.47.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "webtorrent": "^3.0.21"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-updater": "^6.8.9",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "wait-on": "^9.1.0"
  },
  "build": {
    "appId": "com.littlegods.games",
    "productName": "Littlegods Games",
    "asar": true,
    "npmRebuild": false,
    "files": [
      "build/renderer/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage",
      "category": "Game"
    },
    "publish": {
      "provider": "github",
      "owner": "andr3xcl",
      "repo": "littlegods-games",
      "releaseType": "release"
    }
  }
}
